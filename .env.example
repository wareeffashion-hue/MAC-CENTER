# عنوان الموقع العام (يستخدم في الروابط وخريطة الموقع وصور المشاركة)
PUBLIC_URL=https://maccenter.com.sa
PORT=3000
# مجلد قاعدة البيانات والمرفقات
DATA_DIR=./data
# مفتاح سري طويل وعشوائي لتوقيع الروابط والجلسات
APP_SECRET=

# أول حساب مدير يُنشأ عند أول تشغيل (غيّر كلمة المرور بعد الدخول)
ADMIN_EMAIL=admin@maccenter.com.sa
ADMIN_PASSWORD=

# واتساب: mock للتجربة المحلية، cloud للربط الرسمي عبر WhatsApp Cloud API
WHATSAPP_DRIVER=mock
WHATSAPP_PHONE_NUMBER=966509191040
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Google Business Profile: mock للتجربة، api للربط الرسمي
GOOGLE_DRIVER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
