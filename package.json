{
  "name": "mac-center",
  "version": "1.0.0",
  "description": "موقع ماك سنتر ولوحة إدارته: الفروع والأقسام والعروض والاشتراك عبر واتساب والملاحظات وتقييمات Google",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "seed:demo": "node --no-warnings=ExperimentalWarning scripts/demo.js",
    "create-admin": "node --no-warnings=ExperimentalWarning scripts/create-admin.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0"
  }
}
